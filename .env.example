GIRAFFE_ORACLE_ENV=development
GIRAFFE_ORACLE_HOST=localhost
GIRAFFE_ORACLE_PORT=8780
GIRAFFE_ORACLE_EXTERNAL_WRITES=false
# Test-only write enablement additionally requires:
# GIRAFFE_ORACLE_ENV=test
# GIRAFFE_ORACLE_TEST_WRITE_ACK=synthetic-only

# Optional read-only Oracle -> Kit integration. Configure all five together.
# GIRAFFE_ORACLE_KIT_ROOT=<absolute path to the unchanged Kit checkout>
# GIRAFFE_ORACLE_KIT_BASE_URL=http://127.0.0.1:8781
# GIRAFFE_ORACLE_KIT_PROFILE_ID=<deployment-owned public projection profile>
# GIRAFFE_ORACLE_KIT_REGISTER_ID=<approved public registerId, lowercase bytes32>
# GIRAFFE_ORACLE_KIT_VERIFICATION_PROFILE=<approved proof-profile ID, lowercase bytes32>
# Supply GIRAFFE_ORACLE_KIT_API_KEY through protected runtime configuration only.
