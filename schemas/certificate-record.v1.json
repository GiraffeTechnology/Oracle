{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:giraffe:oracle:schema:certificate-record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "certificateHash", "certificateVersion"],
  "properties": {
    "assetId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{3,128}$" },
    "certificateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "certificateVersion": { "type": "integer", "minimum": 1 },
    "previousCertificateHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "effectiveAt": { "type": "string", "format": "date-time" }
  }
}

