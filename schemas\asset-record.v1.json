{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:giraffe:oracle:schema:asset-record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "wenbaoRegistryRef", "assetFingerprintHash", "transferEligibility", "warehouseId", "warehouseReceiptHash", "currentCertificateHash", "currentCertificateVersion", "currentOwnerCommitment", "encumbranceStatus", "oracleStatus", "updatedAt"],
  "properties": {
    "assetId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{3,128}$" },
    "assetFingerprintHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "wenbaoRegistryRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "classificationCode": { "type": "string", "maxLength": 64 },
    "transferEligibility": { "type": "string", "enum": ["VALID", "INVALID", "TRANSFER_PENDING", "FROZEN", "REVOKED", "EXPIRED", "REVIEW_REQUIRED", "NOT_VERIFIED"] },
    "warehouseId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "warehouseReceiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "currentCertificateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "currentCertificateVersion": { "type": "integer", "minimum": 1 },
    "currentOwnerCommitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "encumbranceStatus": { "type": "string", "maxLength": 64 },
    "oracleStatus": { "type": "string", "enum": ["VALID", "INVALID", "TRANSFER_PENDING", "FROZEN", "REVOKED", "EXPIRED", "REVIEW_REQUIRED", "NOT_VERIFIED"] },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
