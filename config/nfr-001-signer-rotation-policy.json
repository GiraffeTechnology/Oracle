{
  "schemaVersion": 1,
  "policyId": "oracle-nfr001-test-only-rotation-v1",
  "scope": "TEST_ONLY_NO_REAL_VALUE",
  "productionKeyMaterialAllowed": false,
  "networkAccessAllowed": false,
  "transactionSigningAllowed": false,
  "approval": {
    "minimumDistinctApprovers": 2,
    "requesterMayApprove": false,
    "timelockSeconds": 300
  },
  "rotation": {
    "steps": [
      "verify-protected-store-and-service-identity",
      "record-old-and-new-public-signer-set-identifiers",
      "collect-two-distinct-approvals",
      "wait-full-timelock",
      "activate-new-test-signer",
      "verify-new-signer-accepted",
      "retire-old-test-signer",
      "verify-old-signer-rejected",
      "verify-audit-chain-and-zero-private-material-observation"
    ]
  },
  "rollback": {
    "windowSeconds": 3600,
    "minimumDistinctApprovers": 2,
    "newSignerFailureRequired": true,
    "auditEventRequired": true,
    "privateMaterialExportAllowed": false
  },
  "acceptance": {
    "newSignerAccepted": true,
    "oldSignerRejected": true,
    "rotationAudited": true,
    "privateMaterialObserved": false,
    "privateMaterialExported": false,
    "networkUsed": false,
    "transactionSigned": false
  }
}
