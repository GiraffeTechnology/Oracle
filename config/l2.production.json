{
  "profileId": "giraffe-oracle-l2/production-v1",
  "service": {
    "bindHost": "localhost",
    "port": 8780,
    "publicBaseUrlRef": "deployment://oracle/public-base-url",
    "timeZone": "UTC"
  },
  "database": {
    "driver": "mysql",
    "connectionRef": "deployment://mysql/oracle",
    "schemaVersion": "oracle-db.v1",
    "tlsRequired": true,
    "appendOnlyAudit": true
  },
  "signer": {
    "provider": "protected-external",
    "signerSetRef": "deployment://signer/oracle-attestation-v1",
    "algorithm": "Ed25519",
    "privateMaterialExportable": false
  },
  "sources": [
    {
      "sourceId": "authoritative-registry",
      "kind": "REGISTRY",
      "transportRef": "deployment://source/registry",
      "keySetRef": "deployment://source-keyset/registry",
      "schemaVersions": ["asset-record.v1"]
    },
    {
      "sourceId": "authoritative-certificate",
      "kind": "CERTIFICATE_AUTHORITY",
      "transportRef": "deployment://source/certificate-authority",
      "keySetRef": "deployment://source-keyset/certificate-authority",
      "schemaVersions": ["certificate-record.v1"]
    },
    {
      "sourceId": "authoritative-warehouse",
      "kind": "WAREHOUSE",
      "transportRef": "deployment://source/warehouse",
      "keySetRef": "deployment://source-keyset/warehouse",
      "schemaVersions": ["warehouse-record.v1"]
    }
  ],
  "events": {
    "publisherRef": "deployment://events/oracle-outbox",
    "delivery": "at-least-once",
    "deadLetterEnabled": true
  },
  "security": {
    "adminAuthenticationRef": "deployment://identity/oracle-admin",
    "dualControlRequired": true,
    "callerEndpointsRejected": true,
    "sensitiveFieldsInLogs": false
  },
  "retention": {
    "policyId": "oracle-retention-v1",
    "evidenceDays": 2555,
    "auditDays": 3650,
    "identityDays": 90
  },
  "operations": {
    "healthRef": "deployment://monitoring/oracle-health",
    "alertingRef": "deployment://monitoring/oracle-alerts",
    "backupRef": "deployment://backup/oracle-mysql",
    "disasterRecoveryRef": "deployment://recovery/oracle"
  }
}
