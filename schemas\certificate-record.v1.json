{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:giraffe:oracle:schema:certificate-record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetId", "tokenId", "certificateVersion", "certificateHash", "previousCertificateHash", "wenbaoChangeRef", "warehouseReceiptHash", "effectiveAt", "status"],
  "properties": {
    "assetId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{3,128}$" },
    "tokenId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "certificateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "certificateVersion": { "type": "integer", "minimum": 1 },
    "previousCertificateHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "wenbaoChangeRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "warehouseReceiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "effectiveAt": { "type": "string", "format": "date-time" },
    "supersededAt": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["CURRENT", "SUPERSEDED", "REVOKED"] }
  }
}
